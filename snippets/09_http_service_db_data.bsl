// Расширение «Ревизор: данные базы»: общий модуль HTTP-сервиса — таблицы хранения, индексы, размер данных, число записей.
// Фрагмент проекта «Ревизор» (превью).

#Область ПрограммныйИнтерфейс

// Проверяет, может ли текущий пользователь получать данные базы через HTTP-сервис Ревизора.
//
// Возвращаемое значение:
//  Булево - Истина, если у пользователя есть роль «Ревизор: доступ к данным базы» или право администрирования.
//
Функция ДоступРазрешен() Экспорт

	Возврат (РольДоступна("рвз_ДоступКДаннымБазы") Или ПравоДоступа("Администрирование", Метаданные));

КонецФункции

// Возвращает общие сведения о конфигурации и базе.
//
// Возвращаемое значение:
//  Структура - сведения для ответа HTTP-сервиса:
//   * configuration - Строка - имя конфигурации.
//   * synonym - Строка - синоним конфигурации.
//   * version - Строка - версия конфигурации.
//   * compatibility - Строка - режим совместимости.
//   * platform - Строка - версия платформы сервера.
//   * objects - Число - количество объектов метаданных, которые хранят данные.
//   * time - Строка - время сеанса в формате XML.
//   * extensions - Массив из Структура - имя, версия и активность расширений.
//
Функция СведенияОБазе() Экспорт

	СистемнаяИнформация = Новый СистемнаяИнформация;

	Сведения = Новый Структура;
	Сведения.Вставить("configuration", Метаданные.Имя);
	Сведения.Вставить("synonym", Метаданные.Синоним);
	Сведения.Вставить("version", Метаданные.Версия);
	Сведения.Вставить("compatibility", Строка(Метаданные.РежимСовместимости));
	Сведения.Вставить("platform", СистемнаяИнформация.ВерсияПриложения);
	Сведения.Вставить("objects", ОбъектыСДанными().Количество());
	Сведения.Вставить("time", XMLСтрока(ТекущаяДатаСеанса()));
	Сведения.Вставить("extensions", ОписаниеРасширений());

	Возврат Сведения;

КонецФункции

// Возвращает таблицы хранения порции объектов метаданных: имена таблиц СУБД, индексы, размер данных.
//
// Параметры:
//  Смещение - Число - номер первого объекта порции, с нуля.
//  Количество - Число - сколько объектов в порции.
//  СчитатьЗаписи - Булево - считать число записей таблиц запросом (на больших базах долго).
//
// Возвращаемое значение:
//  Структура - ответ HTTP-сервиса:
//   * tables - Массив из Структура - описания таблиц хранения.
//   * next - Число - смещение следующей порции или -1, если порция последняя.
//   * total - Число - всего объектов.
//
Функция ТаблицыХранения(Смещение, Количество, СчитатьЗаписи) Экспорт

	Объекты = ОбъектыСДанными();
	Граница = Мин(Смещение + Количество, Объекты.Количество());

	Порция = Новый Массив;
	Для Индекс = Смещение По Граница - 1 Цикл
		Порция.Добавить(Объекты[Индекс]);
	КонецЦикла;

	Таблицы = Новый Массив;
	Если Порция.Количество() > 0 Тогда
		// Структура хранения и размер данных доступны только администратору.
		УстановитьПривилегированныйРежим(Истина);
		СтруктураХранения = ПолучитьСтруктуруХраненияБазыДанных(Порция, Ложь);
		РазмерыОбъектов = РазмерыДанных(Порция);
		ЧислаЗаписей = ?(СчитатьЗаписи, КоличествоЗаписей(СтруктураХранения), Новый Соответствие);
		Для Каждого ОписаниеТаблицы Из СтруктураХранения Цикл
			Таблицы.Добавить(ОписаниеТаблицыХранения(ОписаниеТаблицы, РазмерыОбъектов, ЧислаЗаписей));
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("tables", Таблицы);
	Результат.Вставить("next", ?(Граница < Объекты.Количество(), Граница, -1));
	Результат.Вставить("total", Объекты.Количество());

	Возврат Результат;

КонецФункции

// Имя события журнала регистрации для ошибок HTTP-сервиса Ревизора.
//
// Возвращаемое значение:
//  Строка - имя события на основном языке конфигурации.
//
Функция ИмяСобытияЖурнала() Экспорт

	Возврат НСтр("ru = 'Ревизор.Данные базы'", Метаданные.ОсновнойЯзык.КодЯзыка);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объекты метаданных, которые хранят данные, в постоянном порядке: порции не пересекаются между запросами.
Функция ОбъектыСДанными()

	Коллекции = Новый Массив;
	Коллекции.Добавить(Метаданные.Константы);
	Коллекции.Добавить(Метаданные.Справочники);
	Коллекции.Добавить(Метаданные.Документы);
	Коллекции.Добавить(Метаданные.Перечисления);
	Коллекции.Добавить(Метаданные.ПланыВидовХарактеристик);
	Коллекции.Добавить(Метаданные.ПланыСчетов);
	Коллекции.Добавить(Метаданные.ПланыВидовРасчета);
	Коллекции.Добавить(Метаданные.ПланыОбмена);
	Коллекции.Добавить(Метаданные.БизнесПроцессы);
	Коллекции.Добавить(Метаданные.Задачи);
	Коллекции.Добавить(Метаданные.РегистрыСведений);
	Коллекции.Добавить(Метаданные.РегистрыНакопления);
	Коллекции.Добавить(Метаданные.РегистрыБухгалтерии);
	Коллекции.Добавить(Метаданные.РегистрыРасчета);

	Объекты = Новый Массив;
	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого ОбъектМетаданных Из Коллекция Цикл
			Объекты.Добавить(ОбъектМетаданных);
		КонецЦикла;
	КонецЦикла;

	Возврат Объекты;

КонецФункции

Функция ОписаниеТаблицыХранения(ОписаниеТаблицы, РазмерыОбъектов, ЧислаЗаписей)

	ИмяОбъекта = ОписаниеТаблицы.Метаданные;
	ИмяТаблицы = ОписаниеТаблицы.ИмяТаблицы;
	Если Не ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ИмяТаблицы = ИмяОбъекта + "." + ОписаниеТаблицы.Назначение;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("object", ИмяОбъекта);
	Описание.Вставить("table", ИмяТаблицы);
	Описание.Вставить("storage", ОписаниеТаблицы.ИмяТаблицыХранения);
	Описание.Вставить("purpose", ОписаниеТаблицы.Назначение);
	Описание.Вставить("indexes", ИндексыТаблицы(ОписаниеТаблицы));

	// Размер известен для объекта целиком: указываем его у основной таблицы.
	Размер = РазмерыОбъектов[ИмяОбъекта];
	Если (ИмяТаблицы = ИмяОбъекта) И (Размер <> Неопределено) Тогда
		Описание.Вставить("objectSizeBytes", Размер);
	КонецЕсли;

	Количество = ЧислаЗаписей[ИмяТаблицы];
	Если Количество <> Неопределено Тогда
		Описание.Вставить("rows", Количество);
	КонецЕсли;

	Возврат Описание;

КонецФункции

Функция ИндексыТаблицы(ОписаниеТаблицы)

	Индексы = Новый Массив;
	Для Каждого ОписаниеИндекса Из ОписаниеТаблицы.Индексы Цикл
		Поля = Новый Массив;
		Для Каждого ОписаниеПоля Из ОписаниеИндекса.Поля Цикл
			ИмяПоля = ?(ЗначениеЗаполнено(ОписаниеПоля.ИмяПоля), ОписаниеПоля.ИмяПоля, ОписаниеПоля.ИмяПоляХранения);
			Поля.Добавить(ИмяПоля);
		КонецЦикла;
		Индексы.Добавить(Поля);
	КонецЦикла;

	Возврат Индексы;

КонецФункции

// Размер данных объектов в байтах. Платформа считает размер только по объекту целиком,
// поэтому запрос выполняется для каждого объекта порции.
Функция РазмерыДанных(Объекты)

	Размеры = Новый Соответствие;
	Для Каждого ОбъектМетаданных Из Объекты Цикл
		ОбъектыРазмера = Новый Массив;
		ОбъектыРазмера.Добавить(ОбъектМетаданных);
		Попытка
			Размеры.Вставить(ОбъектМетаданных.ПолноеИмя(), ПолучитьРазмерДанныхБазыДанных(, ОбъектыРазмера));
		Исключение
			// СУБД не сообщает размер данных: таблицы передаются без него.
			Возврат Размеры;
		КонецПопытки;
	КонецЦикла;

	Возврат Размеры;

КонецФункции

// Число записей основных таблиц и табличных частей порции — одним запросом.
// Служебные таблицы (итоги, движения, границы) запросом не читаются и не считаются.
Функция КоличествоЗаписей(СтруктураХранения)

	// Назначение таблицы зависит от варианта встроенного языка конфигурации.
	ЧитаемыеТаблицы = СтрРазделить("Основная,ТабличнаяЧасть,Main,TabularSection", ",");
	ШаблонЗапроса = "ВЫБРАТЬ ""%1"" КАК ИмяТаблицы, КОЛИЧЕСТВО(*) КАК Количество ИЗ %1 КАК Таблица";

	ЧислаЗаписей = Новый Соответствие;
	ТекстыЗапросов = Новый Массив;
	Для Каждого ОписаниеТаблицы Из СтруктураХранения Цикл
		ЧитаемаяТаблица = (ЧитаемыеТаблицы.Найти(ОписаниеТаблицы.Назначение) <> Неопределено);
		Если ЧитаемаяТаблица И ЗначениеЗаполнено(ОписаниеТаблицы.ИмяТаблицы) Тогда
			// Имя таблицы берётся из структуры хранения, а не из параметров запроса.
			ТекстыЗапросов.Добавить(СтрШаблон(ШаблонЗапроса, ОписаниеТаблицы.ИмяТаблицы));
		КонецЕсли;
	КонецЦикла;
	Если ТекстыЗапросов.Количество() = 0 Тогда
		Возврат ЧислаЗаписей;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ЧислаЗаписей;
	КонецПопытки;
	Пока Выборка.Следующий() Цикл
		ЧислаЗаписей.Вставить(Выборка.ИмяТаблицы, Выборка.Количество);
	КонецЦикла;

	Возврат ЧислаЗаписей;

КонецФункции

Функция ОписаниеРасширений()

	Расширения = Новый Массив;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			Описание = Новый Структура("name, version, active", Расширение.Имя, Расширение.Версия, Расширение.Активно);
			Расширения.Добавить(Описание);
		КонецЦикла;
	Исключение
		// Список расширений недоступен: сведения передаются без него.
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Расширения;

КонецФункции

#КонецОбласти
