#Область ПрограммныйИнтерфейс

// Возвращает цену товара по виду цены на дату.
Функция ЦенаТовара(Номенклатура, ВидЦены, Дата = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, ВидЦены = &ВидЦены) КАК Цены
	|ГДЕ
	|	Цены.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.УстановитьПараметр("Дата", ?(Дата = Неопределено, ТекущаяДатаСеанса(), Дата));
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Цена, 0);

КонецФункции

// Возвращает цены сразу для массива товаров — одним запросом.
Функция ЦеныТоваров(Товары, ВидЦены) Экспорт

	Цены = Новый Соответствие;
	Возврат Цены;

КонецФункции

Функция ЦенаСоСкидкой(Цена, Скидка)

	Возврат Цена - Цена * Скидка / 100;

КонецФункции

#КонецОбласти
