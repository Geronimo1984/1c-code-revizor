#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	ЗаполнитьЦены();
	Если Статус = Перечисления.СтатусыЗаказов.Закрытый Тогда
		Отказ = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьЦены()

	Для Каждого СтрокаТовара Из Товары Цикл
		СтрокаТовара.Цена = ЦенообразованиеСервер.ЦенаТовара(СтрокаТовара.Номенклатура, ВидЦены);
		Артикул = СтрокаТовара.Номенклатура.Артикул;
		Если СтрокаТовара.Количество = 0 Тогда
			Товары.Удалить(СтрокаТовара);
		КонецЕсли;
	КонецЦикла;

	Скидка = ЦенообразованиеСервер.ЦенаСоСкидкой(100, 5);
	Итог = ЦенообразованиеСервер.ЦеныТоваров(Товары, ВидЦены, Истина);
	Эталон = Справочники.Товары.ПустаяСсылка();

КонецПроцедуры

Процедура СтарыйРасчетЦен()

	Попытка
		ЗаполнитьЦены();
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
